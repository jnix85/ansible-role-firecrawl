# Ansible managed runtime configuration for Firecrawl
# DO NOT EDIT MANUALLY - Changes may be overwritten by Ansible

# Server Configuration
PORT=3002
HOST=0.0.0.0

# Redis Connection
REDIS_URL={{ firecrawl_redis_url }}
REDIS_RATE_LIMIT_URL={{ firecrawl_redis_rate_limit_url }}

# Playwright Browser Microservice
PLAYWRIGHT_MICROSERVICE_URL={{ firecrawl_playwright_microservice_url }}
BROWSER_POOL_SIZE={{ firecrawl_browser_pool_size }}

# PostgreSQL & NuQ Queue Database
POSTGRES_USER={{ firecrawl_postgres_user }}
POSTGRES_PASSWORD="{{ firecrawl_postgres_password }}"
POSTGRES_DB={{ firecrawl_postgres_db }}
POSTGRES_HOST={{ firecrawl_postgres_host }}
POSTGRES_PORT={{ firecrawl_postgres_port }}
{% if firecrawl_nuq_backend %}
NUQ_BACKEND={{ firecrawl_nuq_backend }}
{% endif %}

# Concurrency & Worker Tuning
NUM_WORKERS_PER_QUEUE={{ firecrawl_num_workers_per_queue }}
CRAWL_CONCURRENT_REQUESTS={{ firecrawl_crawl_concurrent_requests }}
MAX_CONCURRENT_JOBS={{ firecrawl_max_concurrent_jobs }}

# Authentication & Access Control
USE_DB_AUTHENTICATION={{ firecrawl_use_db_authentication | string | lower }}
{% if firecrawl_test_api_key %}
TEST_API_KEY={{ firecrawl_test_api_key }}
{% endif %}
{% if firecrawl_bull_auth_key %}
BULL_AUTH_KEY={{ firecrawl_bull_auth_key }}
{% endif %}
{% if firecrawl_autumn_secret_key %}
AUTUMN_SECRET_KEY={{ firecrawl_autumn_secret_key }}
{% endif %}

# AI / LLM Extract & Map Integration
{% if firecrawl_openai_api_key %}
OPENAI_API_KEY={{ firecrawl_openai_api_key }}
{% endif %}
{% if firecrawl_openai_base_url %}
OPENAI_BASE_URL={{ firecrawl_openai_base_url }}
{% endif %}
{% if firecrawl_model_name %}
MODEL_NAME={{ firecrawl_model_name }}
{% endif %}
{% if firecrawl_model_embedding_name %}
MODEL_EMBEDDING_NAME={{ firecrawl_model_embedding_name }}
{% endif %}
{% if firecrawl_ollama_base_url %}
OLLAMA_BASE_URL={{ firecrawl_ollama_base_url }}
{% endif %}

# Search Engine (SearXNG) Integration
{% if firecrawl_searxng_endpoint %}
SEARXNG_ENDPOINT={{ firecrawl_searxng_endpoint }}
{% endif %}
{% if firecrawl_searxng_engines %}
SEARXNG_ENGINES={{ firecrawl_searxng_engines }}
{% endif %}
{% if firecrawl_searxng_categories %}
SEARXNG_CATEGORIES={{ firecrawl_searxng_categories }}
{% endif %}

# Proxy Settings
{% if firecrawl_proxy_server %}
PROXY_SERVER={{ firecrawl_proxy_server }}
{% endif %}
{% if firecrawl_proxy_username %}
PROXY_USERNAME={{ firecrawl_proxy_username }}
{% endif %}
{% if firecrawl_proxy_password %}
PROXY_PASSWORD={{ firecrawl_proxy_password }}
{% endif %}

# Webhooks & Logging
{% if firecrawl_self_hosted_webhook_url %}
SELF_HOSTED_WEBHOOK_URL={{ firecrawl_self_hosted_webhook_url }}
{% endif %}
{% if firecrawl_slack_webhook_url %}
SLACK_WEBHOOK_URL={{ firecrawl_slack_webhook_url }}
{% endif %}
LOGGING_LEVEL={{ firecrawl_logging_level }}

# Extra Environment Variables
{% for key, value in firecrawl_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
